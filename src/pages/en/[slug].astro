---
import StaticPage from '@/components/pages/StaticPage.astro';
import { STATIC_PAGE_SLUGS } from '@/lib/pages';

export function getStaticPaths() {
  return STATIC_PAGE_SLUGS.map((slug) => ({
    params: { slug },
    props: { slug, locale: 'en' as const },
  }));
}

const { slug, locale } = Astro.props;
---
<StaticPage slug={slug} locale={locale} />

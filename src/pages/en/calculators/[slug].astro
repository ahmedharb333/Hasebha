---
import CalculatorPage from '@/components/pages/CalculatorPage.astro';
import { CALCULATORS } from '@/config/calculators';

export function getStaticPaths() {
  return CALCULATORS.filter((c) => c.active).map((c) => ({
    params: { slug: c.slug },
    props: { slug: c.slug, locale: 'en' as const },
  }));
}

const { slug, locale } = Astro.props;
---
<CalculatorPage slug={slug} locale={locale} />

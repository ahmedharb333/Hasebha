---
import PageLayout from '../../layouts/PageLayout.astro';
import { CALCULATORS } from '../../config/calculators';
import { localizedPath } from '../../lib/i18n';
import type { Category, CalculatorEntry } from '../../config/calculators';
import type { Locale } from '../../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = '/calculators/';
const title = locale === 'ar' ? 'الحاسبات' : 'Calculators';
const description = locale === 'ar'
  ? 'كل الحاسبات المالية وحاسبات العمل في حاسبها: قروض، فائدة مركبة، ادخار، ضريبة، رواتب، عمل إضافي وأكثر.'
  : 'All of Hasebha’s finance and employment calculators: loans, compound interest, savings, VAT, salary, overtime and more.';

const groups: { category: Category; label: string; items: CalculatorEntry[] }[] = [
  { category: 'finance', label: locale === 'ar' ? 'مالية' : 'Finance', items: [] },
  { category: 'employment', label: locale === 'ar' ? 'عمل وتوظيف' : 'Employment', items: [] },
];
for (const c of CALCULATORS.filter((c) => c.active)) {
  const g = groups.find((x) => x.category === c.category)!;
  g.items.push(c);
}
---

<PageLayout locale={locale} path={path} title={title} description={description}>
  {groups.map((group) => (
    <section>
      <h2>{group.label}</h2>
      <div class="tool-grid">
        {group.items.map((c) => (
          <a class="tool-card" data-category={c.category} href={localizedPath(locale, `/calculators/${c.slug}/`)}>
            <span class="tool-card__icon" aria-hidden="true"></span>
            <h3>{c.title[locale]}</h3>
            <p>{c.description[locale]}</p>
            <span class="tool-card__meta">{group.label}</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</PageLayout>
